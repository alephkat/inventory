# Template for backend environment configuration.
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. Fill in real values
# locally; in production inject secrets via the orchestrator or a secrets
# manager rather than an env file baked into an image.
#
# Every value below is a non-functional placeholder. `shared/config/env.ts`
# refuses to start in production if the JWT secrets still contain
# "replace-with", are shorter than 32 characters, or if DATABASE_URL points
# at localhost.

# Application
NODE_ENV=development
PORT=4000

# Database (Neon PostgreSQL). Copy the connection string from the Neon
# console (Connect -> Connection string). It already contains your password
# and `?sslmode=require`. Use the direct (non `-pooler`) host unless you
# intentionally want PgBouncer, in which case add `&pgbouncer=true`.
DATABASE_URL=file:./dev.db

# JWT. Generate independent values of at least 32 characters, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The two must differ; reusing one key for both lets an access token be used
# as a refresh token.
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-prod-at-least-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-prod-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS: comma-separated allowlist of permitted frontend origins. A wildcard
# is rejected when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000

# Password for the seeded `admin` / `super_admin` user. Optional: when unset,
# the seed generates a random password and prints it once. Do not set this
# in production.
# SEED_ADMIN_PASSWORD=CHANGE_ME

